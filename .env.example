# Copy to .env and fill in. Never commit .env.

# Entra app (client) ID — App registrations → your app → Application (client) ID
OUTLOOK_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Directory (tenant) ID — single-tenant apps require this
OUTLOOK_MCP_TENANT_ID=00000000-0000-0000-0000-000000000000
